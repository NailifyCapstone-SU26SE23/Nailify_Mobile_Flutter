<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nail_set_list_fragment">

    <fragment
        android:id="@+id/nail_set_list_fragment"
        android:name="com.google.mediapipe.examples.handlandmarker.fragment.NailSetListFragment"
        android:label="NailSetListFragment">
        <action
            android:id="@+id/action_nail_set_list_to_detail"
            app:destination="@id/nail_set_detail_fragment" />
    </fragment>

    <fragment
        android:id="@+id/nail_set_detail_fragment"
        android:name="com.google.mediapipe.examples.handlandmarker.fragment.NailSetDetailFragment"
        android:label="NailSetDetailFragment">
        <argument
            android:name="nailSetId"
            app:argType="string" />
        <action
            android:id="@+id/action_nail_set_detail_to_camera"
            app:destination="@id/camera_fragment" />
        <action
            android:id="@+id/action_nail_set_detail_to_gallery"
            app:destination="@id/gallery_fragment" />
    </fragment>

    <fragment
        android:id="@+id/permissions_fragment"
        android:name="com.google.mediapipe.examples.handlandmarker.fragment.PermissionsFragment"
        android:label="PermissionsFragment">

        <action
            android:id="@+id/action_permissions_to_camera"
            app:destination="@id/camera_fragment"
            app:popUpTo="@id/permissions_fragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/camera_fragment"
        android:name="com.google.mediapipe.examples.handlandmarker.fragment.CameraFragment"
        android:label="CameraFragment">

        <action
            android:id="@+id/action_camera_to_permissions"
            app:destination="@id/permissions_fragment"
            app:popUpTo="@id/camera_fragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/gallery_fragment"
        android:name="com.google.mediapipe.examples.handlandmarker.fragment.GalleryFragment"
        android:label="GalleryFragment">
        <argument
            android:name="autoOpenPicker"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <fragment
        android:id="@+id/nail_builder_fragment"
        android:name="com.google.mediapipe.examples.handlandmarker.fragment.NailBuilderFragment"
        android:label="NailBuilderFragment">
        <argument
            android:name="nailSetId"
            app:argType="integer"
            android:defaultValue="1" />
        <action
            android:id="@+id/action_builder_to_camera"
            app:destination="@id/camera_fragment" />
        <action
            android:id="@+id/action_builder_to_gallery"
            app:destination="@id/gallery_fragment" />
        <action
            android:id="@+id/action_builder_to_preview"
            app:destination="@id/design_preview_fragment" />
    </fragment>

    <fragment
        android:id="@+id/design_preview_fragment"
        android:name="com.google.mediapipe.examples.handlandmarker.fragment.DesignPreviewFragment"
        android:label="DesignPreviewFragment">
        <action
            android:id="@+id/action_preview_to_camera"
            app:destination="@id/camera_fragment" />
        <action
            android:id="@+id/action_preview_to_gallery"
            app:destination="@id/gallery_fragment" />
    </fragment>
</navigation>
