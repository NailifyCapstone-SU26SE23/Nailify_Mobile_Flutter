<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 1. Preview camera -->
    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillStart" />

    <!-- Freeze frame hiển thị sau khi chụp -->
    <ImageView
        android:id="@+id/img_freeze_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- Shutter flash animation overlay -->
    <View
        android:id="@+id/view_shutter_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF"
        android:visibility="gone" />

    <!-- MediaPipe Live Overlay -->
    <com.google.mediapipe.examples.handlandmarker.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Header Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_revert"
            android:scaleType="centerInside"
            android:rotation="180"
            app:tint="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/txt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AR Try-on"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Subtitle: Move your hand slowly -->
    <TextView
        android:id="@+id/txt_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Move your hand slowly ✨"
        android:textColor="#E0E0E0"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. Hand Guide Frame in Center -->
    <FrameLayout
        android:id="@+id/img_hand_guide"
        android:layout_width="280dp"
        android:layout_height="340dp"
        android:background="@drawable/bg_hand_guide"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Place your hand inside the frame for best results"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Zoom controls (floating on right) -->
    <LinearLayout
        android:id="@+id/layout_zoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#80000000"
            app:cardElevation="0dp">
            <Button
                android:id="@+id/btn_zoom_in"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:text="+"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="0dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#80000000"
            app:cardElevation="0dp">
            <Button
                android:id="@+id/btn_zoom_out"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:text="−"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="0dp" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- 4. Bottom Controls Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Gallery Button (Left) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_gallery"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="36dp"
            app:cardCornerRadius="27dp"
            app:cardBackgroundColor="#4DFFFFFF"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/layout_capture_button"
            app:layout_constraintBottom_toBottomOf="@id/layout_capture_button">

            <ImageButton
                android:id="@+id/btn_gallery"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_baseline_photo_library_24"
                android:scaleType="centerInside"
                app:tint="@android:color/white" />
        </androidx.cardview.widget.CardView>

        <!-- Capture Button (Center - Graduate outer circle with white inner) -->
        <FrameLayout
            android:id="@+id/layout_capture_button"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_capture_button_gradient"
            android:padding="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Card chụp Live (Live Mode) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_capture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="36dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="0dp">

                <ImageButton
                    android:id="@+id/btn_capture"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@android:color/transparent" />
            </androidx.cardview.widget.CardView>

            <!-- Card chụp Snapshot (Snapshot Mode) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_take_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:cardCornerRadius="36dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="0dp">

                <ImageButton
                    android:id="@+id/btn_take_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@android:color/transparent" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Flip Camera Button (Right) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_flip"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginEnd="36dp"
            app:cardCornerRadius="27dp"
            app:cardBackgroundColor="#4DFFFFFF"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/layout_capture_button"
            app:layout_constraintBottom_toBottomOf="@id/layout_capture_button">

            <ImageButton
                android:id="@+id/btn_flip_camera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_flip_camera"
                android:scaleType="centerInside"
                app:tint="@android:color/white" />
        </androidx.cardview.widget.CardView>

        <!-- Confirm this look (Bottom white pill button) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_confirm_look"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            app:cardCornerRadius="25dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/layout_capture_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/btn_confirm_look"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Confirm this look"
                android:textColor="@android:color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackground" />
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>