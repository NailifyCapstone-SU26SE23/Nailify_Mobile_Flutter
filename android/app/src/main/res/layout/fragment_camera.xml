<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillStart" />

    <com.google.mediapipe.examples.handlandmarker.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        Khung viền hướng dẫn đặt bàn tay.
        Chỉ visible khi ở chế độ Snapshot (set từ CameraFragment).
        Dùng vector drawable riêng nếu có; tạm dùng src placeholder.
    -->
    <ImageView
        android:id="@+id/img_hand_guide"
        android:layout_width="260dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:alpha="0.5"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="Đặt bàn tay vào khung này" />

    <!-- Nút Back -->
    <androidx.cardview.widget.CardView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="#80000000"
        app:cardElevation="0dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@android:color/white" />
    </androidx.cardview.widget.CardView>

    <!-- Nhóm Zoom In / Out (cạnh phải) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#80000000"
            app:cardElevation="0dp">

            <Button
                android:id="@+id/btn_zoom_in"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:text="+"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#80000000"
            app:cardElevation="0dp">

            <Button
                android:id="@+id/btn_zoom_out"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:text="−"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Nút chụp Live (lưu thư viện) — chỉ hiện ở Live mode -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_capture"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="36dp"
        app:cardBackgroundColor="#CCFFFFFF"
        app:cardElevation="4dp">

        <ImageButton
            android:id="@+id/btn_capture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="#000000" />
    </androidx.cardview.widget.CardView>

    <!--
        Nút chụp Snapshot — chỉ hiện ở Snapshot mode.
        Màu hồng (pink) để phân biệt với nút Live.
        Khi bấm: Native chụp ảnh → MediaPipe IMAGE → trả JSON + path về Flutter.
    -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_take_photo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:visibility="gone"
        app:cardCornerRadius="40dp"
        app:cardBackgroundColor="#FFFF69B4"
        app:cardElevation="6dp">

        <ImageButton
            android:id="@+id/btn_take_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="@android:color/white" />
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
